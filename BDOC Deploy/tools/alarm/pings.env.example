# /etc/bdoc-alarm/pings.env — root only (chmod 600). Copy of this template with real URLs.
# Never commit real ping URLs: anyone holding one can fake "all is well".
# Each URL is a Healthchecks.io ping URL, e.g. https://hc-ping.com/<uuid>

# systemd units to watch, space separated. Each needs an HC_SVC_<name with - as _> line.
BDOC_ALARM_SERVICES="hermes-gateway bdoc-wire bdoc-alarm-canary"

# Droplet heartbeat: silent = power loss, hard shutdown, network gone, or the timer died.
HC_HEARTBEAT=
# Clean-shutdown check: DOWN on a planned shutdown/reboot, UP again at boot.
HC_LIFECYCLE=

HC_SVC_hermes_gateway=
HC_SVC_bdoc_wire=
HC_SVC_bdoc_alarm_canary=

# p202 tripwire (tools/hardening/bdoc-tripwire): 5 min period / 10 min grace.
HC_TRIPWIRE=
